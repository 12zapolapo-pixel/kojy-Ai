{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "baseUrl": ".",
    "types": ["react", "react-dom", "vite/client"],
    "paths": {
      "@/*":                  ["./src/*"],
      "@kojyai/ui":           ["../../packages/ui/src/index.ts"],
      "@kojyai/ui/*":         ["../../packages/ui/src/*"],
      "@kojyai/shared":       ["../../packages/shared/src/index.ts"],
      "@kojyai/shared/*":     ["../../packages/shared/src/*"],
      "@kojyai/engine":       ["../../packages/engine/src/index.ts"],
      "@kojyai/engine/*":     ["../../packages/engine/src/*"],
      "@kojyai/contracts":    ["../../packages/contracts/src/index.ts"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist"]
}

# KojyAI web front door: serves the website and proxies the API.
#
# SITE_ADDRESS decides HTTP vs HTTPS:
#   :80                          plain HTTP on the server's IP (default)
#   123-45-67-89.sslip.io        free hostname for your IP → Caddy fetches a
#                                real HTTPS certificate automatically
#   kojy.example.com             your own domain later
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# API: the website calls /api/trpc/...; the API itself serves /trpc/...
	handle_path /api/* {
		reverse_proxy api:3001
	}

	# Live updates (WebSocket) and the Stripe webhook go through unchanged.
	handle /ws* {
		reverse_proxy api:3001
	}
	handle /stripe/* {
		reverse_proxy api:3001
	}

	# The website: a single-page app, so unknown paths fall back to index.html.
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

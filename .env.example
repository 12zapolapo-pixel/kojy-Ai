# ════════════════════════════════════════════════════════════════════════
#  KojyAI settings
#
#  On the server, don't copy this by hand: run ./scripts/setup-env.sh, which
#  creates .env with fresh random secrets and asks for the few values only
#  you know. This file documents every setting. Never commit .env.
#
#  Empty optional values are fine — leave a line blank to switch a feature off.
# ════════════════════════════════════════════════════════════════════════

# ── Where the site lives ─────────────────────────────────────────────────
# The address people type into the browser, without a trailing slash.
#   http://<server-ip>                      plain HTTP (works right away)
#   https://<ip-with-dashes>.sslip.io       free HTTPS, no domain needed
FRONTEND_URL=http://localhost
# What the web container answers on. ":80" = plain HTTP on any address;
# a hostname (e.g. 132-145-1-2.sslip.io) makes Caddy get an HTTPS certificate.
SITE_ADDRESS=:80

# ── Secrets (setup-env.sh generates these) ──────────────────────────────
# openssl rand -hex 32
POSTGRES_PASSWORD=
# openssl rand -hex 32
REDIS_PASSWORD=
# openssl rand -hex 64
JWT_SECRET=
# openssl rand -hex 32 — encrypts bot tokens in the database. Keep a copy:
# losing it means re-entering every bot token.
ENCRYPTION_KEY=

# ── AI (at least one key) ────────────────────────────────────────────────
# Groq — free key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional: which Groq model chat replies use (default openai/gpt-oss-20b)
GROQ_MODEL=
# Kojy, the coder AI. Recommended: a free Gemini key (https://aistudio.google.com/apikey)
# as Kojy's main AI. Its free plan fits ~10x more conversation and code than
# Groq's; Kojy moves to Groq by itself when Gemini's daily limit is used up.
# On Gemini's free plan Google may use what Kojy sends (bot code, your chat
# with Kojy) to improve its products; secret values are never sent to Kojy.
AGENT_API_KEY=
# Optional: another Gemini model (gemini-3.8-flash is newer but was very slow on
# the free plan in Oct 2026) or another OpenAI-compatible AI. Defaults:
#   AGENT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AGENT_MODEL=gemini-3.6-flash
# Budgets for Kojy's main AI; the defaults suit Gemini's free plan. Without
# AGENT_API_KEY, AGENT_MODEL and these apply to Groq (defaults suit its free
# plan; raise them on a paid key).
AGENT_MODEL=
AGENT_TOKENS_PER_MINUTE=
AGENT_HISTORY_TOKENS=
# Optional extra providers
OPENAI_API_KEY=
MISTRAL_API_KEY=
# groq | openai | mistral — empty = first provider with a key
AI_PROVIDER=

# ── Accounts ─────────────────────────────────────────────────────────────
# The first account created becomes the owner (active right away, no email
# needed). After that sign-ups are closed; set to "open" to let others join
# (they verify by email code — printed in `docker compose logs api` until
# RESEND_API_KEY is set).
SIGNUPS=closed

# ── Billing ──────────────────────────────────────────────────────────────
# Off: every feature is free and unlocked. To sell plans later, set this to
# false and fill in the Stripe values below.
BILLING_DISABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=
STRIPE_PRICE_ENTERPRISE=

# ── Email ────────────────────────────────────────────────────────────────
# Resend (https://resend.com, free tier). Leave empty until you have it.
RESEND_API_KEY=

# ── Backups (worker) ─────────────────────────────────────────────────────
# Daily pg_dump into the "backups" Docker volume, kept this many days.
BACKUP_KEEP_DAYS=14
# Restore the newest backup into a scratch database to prove it works:
# every Sunday by default, or "always" to do it after every backup.
BACKUP_RESTORE_TEST=
# Days of bot activity kept for Analytics (default 180).
ANALYTICS_KEEP_DAYS=

# ── Alerts (optional) ─────────────────────────────────────────────────────
# A Discord (or Slack-compatible) incoming-webhook URL. When set, you get a
# message when a bot keeps crashing, Kojy auto-fixes one, Highrise rejects a
# bot's token, or a backup fails. Discord: channel → Edit → Integrations →
# Webhooks → New Webhook → Copy URL.
ALERT_WEBHOOK_URL=
# Optional off-server copy to S3 (needs the aws CLI credentials below).
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Optional integrations ────────────────────────────────────────────────
# Web search for bots (https://serper.dev)
SERPER_API_KEY=
# Image generation (https://replicate.com)
REPLICATE_API_KEY=
# Semantic memory embeddings: OpenAI (uses OPENAI_API_KEY) or a local Ollama
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_EMBEDDING_MODEL=

# ── Logging ──────────────────────────────────────────────────────────────
# trace | debug | info | warn | error
LOG_LEVEL=info

# ════════════════════════════════════════════════════════════════════════
#  Local development only (pnpm dev, not Docker). docker-compose.yml sets
#  these itself for the containers.
# ════════════════════════════════════════════════════════════════════════
# DATABASE_URL=postgres://kojyai:kojyai_dev@localhost:5432/kojyai
# REDIS_URL=redis://localhost:6379
# NODE_ENV=development

# ── Advanced (rarely needed) ─────────────────────────────────────────────
# DB_AUTO_MIGRATE=false            # the API applies DB migrations on boot unless false
# DB_POOL_SIZE=20
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_SSL=true                      # TLS to a managed/remote Postgres
# DB_SSL_CA=/path/to/ca.pem
# REDIS_TLS=true                   # or use a rediss:// URL
# ENCRYPTION_KEY_ID=2              # key rotation, see packages/shared/src/crypto/apiKeys.ts
# ENCRYPTION_KEYS_PREVIOUS=1:<old 64-hex key>
# WS_EXTRA_ALLOWED_ORIGINS=https://other.example.com
# DELEGATION_SANDBOX_MODE=vm       # vm | docker
